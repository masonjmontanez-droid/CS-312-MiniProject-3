<!DOCTYPE html>
<html>
<head>

  <title>Edit Post</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<h1>Edit Post</h1>

<form action="/posts/<%= post.blog_id %>/edit" method="POST">
  <label>Title:</label>

 <input type="text" name="title" value="<%= post.title %>" required>
<br>
  <label>Content:</label>

  <br>
 <textarea name="body" rows="5" cols="20" required><%= post.body %></textarea>
  <br>

  <label>Category:</label>
  <select name="category">
  <option value="Fitness" <%= post.category === 'Fitness' ? 'selected' : '' %>>Fitness</option>
    <option value="Hobbys" <%= post.category === 'Hobbys' ? 'selected' : '' %>>Hobbys</option>
  <option value="Professional" <%= post.category === 'Professional' ? 'selected' : '' %>>Professional</option>
  </select>
  <br>

  <button type="submit">Save</button>

</form>

<p><a href="/">Back to all posts</a></p>

</body>


</html>
